---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="input-file-ssr">Input File: SSR</h1>

  <h2>Basic input file</h2>
  <lion-input-file label="Upload file"></lion-input-file>

  <h2>Multiple files</h2>
  <lion-input-file multiple label="Upload files"></lion-input-file>

  <h2>Disabled input file</h2>
  <lion-input-file label="Upload file" disabled></lion-input-file>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-input-file.js';
  </script>
</MainLayout>


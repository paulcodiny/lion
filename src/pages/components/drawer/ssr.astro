---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="drawer-ssr">Drawer: SSR</h1>

  <h2>Basic drawer (left)</h2>
  <lion-drawer>
    <button slot="invoker">Open Drawer</button>
    <p slot="headline">Drawer Title</p>
    <div slot="content">
      <p>This is the drawer content</p>
    </div>
  </lion-drawer>

  <h2>Drawer positioned right</h2>
  <lion-drawer position="right">
    <button slot="invoker">Open Right Drawer</button>
    <p slot="headline">Right Drawer</p>
    <div slot="content">
      <p>This drawer opens from the right</p>
    </div>
  </lion-drawer>

  <h2>Drawer positioned top</h2>
  <lion-drawer position="top">
    <button slot="invoker">Open Top Drawer</button>
    <p slot="headline">Top Drawer</p>
    <div slot="content">
      <p>This drawer opens from the top</p>
    </div>
  </lion-drawer>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-drawer.js';
  </script>
</MainLayout>


---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="textarea-ssr">Textarea: SSR</h1>

  <h2>Basic textarea</h2>
  <lion-textarea label="Comments"></lion-textarea>

  <h2>Disabled textarea</h2>
  <lion-textarea label="Disabled" disabled></lion-textarea>

  <h2>Readonly textarea</h2>
  <lion-textarea label="Readonly" readonly></lion-textarea>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-textarea.js';
  </script>
</MainLayout>


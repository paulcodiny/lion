---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="checkbox-group-ssr">Checkbox Group: SSR</h1>

  <h2>Basic checkbox group</h2>
  <lion-checkbox-group name="scientists" label="Favorite scientists">
    <lion-checkbox label="Archimedes" choice-value="Archimedes"></lion-checkbox>
    <lion-checkbox label="Francis Bacon" choice-value="Francis Bacon"></lion-checkbox>
    <lion-checkbox label="Marie Curie" choice-value="Marie Curie"></lion-checkbox>
  </lion-checkbox-group>

  <h2>Pre-selected option</h2>
  <lion-checkbox-group name="scientists2" label="Favorite scientists">
    <lion-checkbox label="Archimedes" choice-value="Archimedes"></lion-checkbox>
    <lion-checkbox label="Francis Bacon" choice-value="Francis Bacon" checked></lion-checkbox>
    <lion-checkbox label="Marie Curie" choice-value="Marie Curie"></lion-checkbox>
  </lion-checkbox-group>

  <h2>Disabled checkbox group</h2>
  <lion-checkbox-group name="scientists3" label="Favorite scientists" disabled>
    <lion-checkbox label="Archimedes" choice-value="Archimedes"></lion-checkbox>
    <lion-checkbox label="Francis Bacon" choice-value="Francis Bacon"></lion-checkbox>
    <lion-checkbox label="Marie Curie" choice-value="Marie Curie"></lion-checkbox>
  </lion-checkbox-group>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-checkbox-group.js';
    import '@lion/ui/define/lion-checkbox.js';
  </script>
</MainLayout>


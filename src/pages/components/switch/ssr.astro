---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="switch-ssr">Switch: SSR</h1>

  <h2>Basic switch</h2>
  <lion-switch label="Subscribe to newsletter"></lion-switch>

  <h2>Checked switch</h2>
  <lion-switch label="Subscribe to newsletter" checked></lion-switch>

  <h2>Disabled switch</h2>
  <lion-switch label="Subscribe to newsletter" disabled></lion-switch>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-switch.js';
  </script>
</MainLayout>


---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="button-ssr">Button: SSR</h1>

  <h2>Basic button</h2>
  <lion-button>Click me</lion-button>

  <h2>Disabled button</h2>
  <lion-button disabled>Disabled</lion-button>

  <h2>Form buttons</h2>
  <form>
    <label for="firstNameId">First name</label>
    <input id="firstNameId" name="firstName" />
    <lion-button-submit>Submit</lion-button-submit>
    <lion-button-reset>Reset</lion-button-reset>
  </form>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-button.js';
    import '@lion/ui/define/lion-button-submit.js';
    import '@lion/ui/define/lion-button-reset.js';
  </script>
</MainLayout>


---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="input-iban-ssr">Input Iban: SSR</h1>

  <h2>Basic input iban</h2>
  <lion-input-iban label="IBAN" name="iban"></lion-input-iban>

  <h2>Disabled input iban</h2>
  <lion-input-iban label="IBAN" name="iban2" disabled></lion-input-iban>

  <h2>With help text</h2>
  <lion-input-iban label="IBAN" name="iban3" help-text="Enter a valid IBAN"></lion-input-iban>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-input-iban.js';
  </script>
</MainLayout>


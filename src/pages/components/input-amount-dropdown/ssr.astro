---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="input-amount-dropdown-ssr">Input Amount Dropdown: SSR</h1>

  <h2>Basic input amount dropdown</h2>
  <lion-input-amount-dropdown label="Select currency via dropdown" name="amount"></lion-input-amount-dropdown>

  <h2>With allowed currencies</h2>
  <lion-input-amount-dropdown
    label="Select currency via dropdown"
    name="amount2"
    allowed-currencies="['EUR', 'GBP', 'USD']"
  ></lion-input-amount-dropdown>

  <h2>Disabled</h2>
  <lion-input-amount-dropdown label="Select currency via dropdown" name="amount3" disabled></lion-input-amount-dropdown>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-input-amount-dropdown.js';
  </script>
</MainLayout>


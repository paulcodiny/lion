---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="calendar-ssr">Calendar: SSR</h1>

  <h2>Basic calendar</h2>
  <lion-calendar style="border: 1px solid #adadad; max-width: 500px;"></lion-calendar>

  <h2>With selected date</h2>
  <lion-calendar
    style="border: 1px solid #adadad; max-width: 500px;"
    .selectedDate=${new Date(2024, 0, 15)}
  ></lion-calendar>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-calendar.js';
  </script>
</MainLayout>


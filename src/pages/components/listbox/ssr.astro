---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="listbox-ssr">Listbox: SSR</h1>

  <h2>Basic listbox</h2>
  <lion-listbox name="fruits" label="Favorite fruit">
    <lion-option .choiceValue=${"Apple"}>Apple</lion-option>
    <lion-option .choiceValue=${"Banana"}>Banana</lion-option>
    <lion-option .choiceValue=${"Carrot"}>Carrot</lion-option>
  </lion-listbox>

  <h2>Multiple choice listbox</h2>
  <lion-listbox name="vegetables" label="Favorite vegetables" multiple-choice>
    <lion-option .choiceValue=${"Artichoke"}>Artichoke</lion-option>
    <lion-option .choiceValue=${"Asparagus"}>Asparagus</lion-option>
    <lion-option .choiceValue=${"Broccoli"}>Broccoli</lion-option>
  </lion-listbox>

  <h2>Horizontal orientation</h2>
  <lion-listbox name="fruits2" label="Orientation horizontal" orientation="horizontal">
    <lion-option .choiceValue=${"Apple"}>Apple</lion-option>
    <lion-option .choiceValue=${"Banana"}>Banana</lion-option>
    <lion-option .choiceValue=${"Carrot"}>Carrot</lion-option>
  </lion-listbox>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-listbox.js';
    import '@lion/ui/define/lion-option.js';
  </script>
</MainLayout>


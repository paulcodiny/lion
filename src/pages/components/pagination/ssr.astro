---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="pagination-ssr">Pagination: SSR</h1>

  <h2>Basic pagination</h2>
  <lion-pagination count="20"></lion-pagination>

  <h2>With current page</h2>
  <lion-pagination count="50" current="10"></lion-pagination>

  <h2>Many pages</h2>
  <lion-pagination count="100" current="50"></lion-pagination>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-pagination.js';
  </script>
</MainLayout>


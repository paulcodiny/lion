---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="input-date-ssr">Input Date: SSR</h1>

  <h2>Basic input date</h2>
  <lion-input-date label="Date"></lion-input-date>

  <h2>With help text</h2>
  <lion-input-date label="Date" help-text="Enter a valid date"></lion-input-date>

  <h2>Disabled input date</h2>
  <lion-input-date label="Date" disabled></lion-input-date>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-input-date.js';
  </script>
</MainLayout>


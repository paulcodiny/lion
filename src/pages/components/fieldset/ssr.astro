---
import MainLayout from "../../../layouts/MainLayout.astro";
---
<MainLayout>
  <h1 id="fieldset-ssr">Fieldset: SSR</h1>

  <h2>Basic fieldset</h2>
  <lion-fieldset name="nameGroup" label="Name">
    <lion-input name="firstName" label="First Name"></lion-input>
    <lion-input name="lastName" label="Last Name"></lion-input>
  </lion-fieldset>

  <h2>Nested fieldsets</h2>
  <lion-fieldset>
    <div slot="label">Personal data</div>
    <lion-fieldset name="nameGroup" label="Name">
      <lion-input name="firstName" label="First Name"></lion-input>
      <lion-input name="lastName" label="Last Name"></lion-input>
    </lion-fieldset>
    <lion-fieldset name="location" label="Location">
      <lion-input name="country" label="Country"></lion-input>
    </lion-fieldset>
    <lion-input name="age" label="Age"></lion-input>
  </lion-fieldset>

  <h2>Disabled fieldset</h2>
  <lion-fieldset name="nameGroup2" label="Name" disabled>
    <lion-input name="firstName" label="First Name"></lion-input>
    <lion-input name="lastName" label="Last Name"></lion-input>
  </lion-fieldset>

  <script>
    import '@webcomponents/scoped-custom-element-registry';
    import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
    import '@lion/ui/define/lion-fieldset.js';
    import '@lion/ui/define/lion-input.js';
  </script>
</MainLayout>

